{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Press club committee or executive member",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "designation": { "type": "string", "maxLength": 200 },
        "media": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "designation", "media", "phone"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Press release or official club notice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "date": { "type": "string", "maxLength": 100 },
        "badge": { "type": "string", "maxLength": 100 },
        "summary": { "type": "string", "maxLength": 1000 },
        "fullText": { "type": "string", "maxLength": 10000 },
        "isImportant": { "type": "boolean" },
        "pdfUrl": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "title", "date", "badge", "summary"]
    },
    "Event": {
      "title": "Event",
      "description": "Press club meeting, workshop or gathering event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "date": { "type": "string", "maxLength": 50 },
        "dateBangla": { "type": "string", "maxLength": 100 },
        "time": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 50 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "organizer": { "type": "string", "maxLength": 200 },
        "chiefGuest": { "type": "string", "maxLength": 200 },
        "speaker": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "registrationOpen": { "type": "boolean" },
        "contactPerson": { "type": "string", "maxLength": 200 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "badge": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title", "date", "location", "category", "description"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Citizen news tip, query, or report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "union": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 300 },
        "details": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "phone", "union", "subject", "details"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter and member applicant subscriber",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 100 },
        "subscribedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "email", "category", "subscribedAt"]
    },
    "ClubInfo": {
      "title": "ClubInfo",
      "description": "General press club identity and contact details",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "established": { "type": "string", "maxLength": 50 },
        "regNo": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "president": { "type": "string", "maxLength": 150 },
        "generalSecretary": { "type": "string", "maxLength": 150 },
        "lastUpdated": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "address", "phone", "email"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designated administrator identity with verified privileges",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "role"]
    },
    "Application": {
      "title": "Application",
      "description": "Membership registration application submitted online",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "mediaName": { "type": "string", "maxLength": 200 },
        "designation": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 50 },
        "appliedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "fullName", "phone", "mediaName", "designation"]
    }
  },
  "firestore": {
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Online membership applications"
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "Committee members and journalists roster"
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Official notices and press releases"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Press club event schedule and workshops"
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/Complaint" },
      "description": "Citizen news reports and queries"
    },
    "/subscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/Subscriber" },
      "description": "Subscribers for newsletters and member updates"
    },
    "/club_info/{infoId}": {
      "schema": { "$ref": "#/entities/ClubInfo" },
      "description": "Official club information and configuration"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin access list for executive privileges"
    }
  }
}
